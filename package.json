{
  "name": "frame-vn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Create branching visual novels with an animated cast, a live storyboard, and portable offline games.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/build-player-runtime.mjs",
    "prebuild": "node scripts/write-notices.mjs && node scripts/build-player-runtime.mjs",
    "pretest": "node scripts/build-player-runtime.mjs",
    "format": "prettier --write src server scripts tests docs *.json *.ts *.md",
    "setup:browser": "playwright install chromium",
    "notices": "node scripts/write-notices.mjs",
    "examples:build": "node scripts/build-examples.mjs",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "Mario Manzocco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marioarttv/frame-vn.git"
  },
  "bugs": {
    "url": "https://github.com/Marioarttv/frame-vn/issues"
  },
  "homepage": "https://github.com/Marioarttv/frame-vn#readme"
}
