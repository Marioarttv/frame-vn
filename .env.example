# Local server only. Never prefix secrets with VITE_.
ELEVENLABS_API_KEY=
# Optional existing env file instead of a key here:
# ELEVENLABS_ENV_FILE=/absolute/path/to/private/.env.local
# Rhubarb executable; .studio/tools/rhubarb and PATH are also checked.
# RHUBARB_PATH=/absolute/path/to/rhubarb
# Optional executable paths:
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
